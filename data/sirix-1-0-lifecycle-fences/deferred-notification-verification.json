{
  "findings": [
    "review-deferred-notification-history",
    "review-bounded-notification-admission"
  ],
  "starting_head": "320ce6ab011e9ee3d054f3b0c789622485ca35a6",
  "review_base": "ce56286b86c0870cea3f652e1fdf319f14641bea",
  "recorded_utc": "2026-11-17T18:00:02.797034+00:00",
  "invariants": [
    "Admitted deferred work retains its original resource/revision history until delivery or explicit permitted abandonment",
    "The single configured capacity includes active, executor-queued and retirement-deferred jobs; overflow neither waits for consumers nor invokes callbacks on the committer",
    "History refusal does not discard conflicting work or wait for another retirement owner; physical worker and callback reentry fences remain in force"
  ],
  "changes": [
    "Immutable notification jobs carry resource ID and revision to delivery; no already-open reader is retained by a queued job",
    "Shared page history admission rejects removal of a protected deferred revision, retaining work for delivery and safe retry",
    "Unrelated resources and retained target revisions remain admissible; ordinary retirement remains shared",
    "Bounded ArrayBlockingQueue plus a combined admission budget covers both queues and active delivery",
    "Best-effort overflow, repeated publication observations, revision exposure and lack of resume/replay are documented"
  ],
  "boundary_trace": [
    "Node and raw bound page maintenance acquire/fence the owning node before the shared page history check",
    "Unbound page maintenance fences its append worker and reaches the same check",
    "Derived history uses that page boundary with its own resource identity; deferred source jobs do not blanket-block unrelated derived resources",
    "Post-hooks and revision listeners both use the recorded revision to open their committed view",
    "Executor/deferred transfer reuses the same immutable job; delivery, submission failure, timeout and close release accounting and queued references"
  ],
