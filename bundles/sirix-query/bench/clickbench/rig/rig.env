# shellcheck shell=bash
# Shared environment for the ClickBench rig scripts. Source it; never execute it.
#
# Every path is derived from this file's location or overridable by environment variable, so the
# scripts run from any checkout. Working files (locks, logs, databases) live under build/, which is
# gitignored.
RIG=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(cd "$RIG/../../../../.." && pwd)
BENCH=$ROOT/bundles/sirix-query/bench/clickbench
WORK=${CB_RIG_WORK:-$ROOT/bundles/sirix-query/build/diagnostics/rig}
mkdir -p "$WORK"
LOCK=$WORK/leg.lock

# Source corpora (ClickBench hits as newline-delimited JSON, gzipped). Never delete these: the 100M
# file is 23.7 GB and takes hours to re-download and convert.
SRC100M=${CB_SRC_100M:-$ROOT/bundles/sirix-query/build/diagnostics/clickbench-official-100m/hits.json.gz}
SRC1M=${CB_SRC_1M:-$ROOT/bundles/sirix-query/build/diagnostics/clickbench-official-100m/hits-1m.json.gz}

# Database directories. Each holds db/ plus the logs of the runs against it. The 100M pointer file is
# written by load100m.sh so the query scripts find the most recent load without an argument.
D100M=${CB100M_DIR:-$(cat "$WORK/current-100m-dir.txt" 2>/dev/null || true)}
D1M=${CB1M_DIR:-$WORK/seg1m}

# JVM envelopes. The 100M query envelope is the ClickBench c6a.4xlarge shape (32 GB box): 14 GB heap
# plus a 10 GiB off-heap arena; the load needs a 16 GB heap and an 8 GiB arena.
JVM100M="-Xms6g -Xmx14g -Dsirix.offheap.bytes=10737418240"
JVM1M="-Xms4g -Xmx8g -Dsirix.offheap.bytes=8589934592"
# Serving flags: auto-vectorise, chunk-framed page bodies at 16 KiB.
SERVE="-Dsirix.query.autoVectorize=true -Dsirix.chunkedBody.enable=true -Dsirix.chunkedBody.targetChunkBytes=16384"
# Load flags: incremental projection index at load start, path summary, FULL versioning (pinned by
# ruling), chunked bodies, the SEGMENT dictionary lane (no prepass, nothing global).
LOADFLAGS="-Dclickbench.projection=true -Dclickbench.projection.incremental=true -DbuildPathSummary=true \
  -DversioningType=FULL -Dsirix.chunkedBody.enable=true -Dsirix.chunkedBody.targetChunkBytes=16384 \
  -Dsirix.projection.segmentDict=true -Dsirix.projection.globalDict=never"

# One leg per box. The lock is necessary but not sufficient: a leg whose wrapper shell was killed
# leaves its JVM running and its lock held by a dead shell, so refuse_live_jvm() checks the process
# table too. Do not put the literal main-class name on the command line that launches these scripts
# (a `bash -c "... ClickBenchRunMain ..."` wrapper would trip its own guard).
take_lock() {
  exec 9>"$LOCK"
  flock -w "${1:-120}" 9 || { echo "ABORT: another leg holds $LOCK"; exit 1; }
}
refuse_live_jvm() {
  if ps -eo args | grep -q '[C]lickBench\(Run\|Load\)Main'; then
    echo "ABORT: a ClickBench JVM is alive -- never launch a leg over a live JVM (exit 137 = OOM-killer)"
    exit 1
  fi
}
require_100m_db() {
  [ -n "$D100M" ] && [ -d "$D100M/db" ] || {
    echo "ABORT: no 100M database (set CB100M_DIR or run load100m.sh; pointer file: $WORK/current-100m-dir.txt)"
    exit 1
  }
}
